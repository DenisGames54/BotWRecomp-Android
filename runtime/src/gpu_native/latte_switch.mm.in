// GENERATED from runtime/src/gpu_native/latte_switch.mm.in by gpu_native.cmake (BOTW_NATIVE_GPU=ON only).
//
// Puts a run-time switch in front of the latte:: interface (runtime/src/latte/latte.h) without
// editing the Cemu glue: runtime/cemu_shims/latte_glue.mm is compiled here (in Cemu's environment,
// replacing its own TU in the cemu_gpu target) with the functions the native backend overrides
// renamed to latte::latte_cemu_*; the real names below forward to either the Cemu version (default)
// or gpu_native::backend:: (--renderer native). Functions not in the list (e.g. new display
// settings the glue gains) keep Cemu's implementation in both modes, so the native build keeps
// linking when latte.h grows. The PM4 statistics tap (--gpu-stats N) sees every submission.

// Everything latte_glue.mm includes, so the renames below only touch the glue itself and latte.h.
#include <TargetConditionals.h>
#if TARGET_OS_IOS
#import <Foundation/Foundation.h>
#import <CoreGraphics/CoreGraphics.h>
#else
