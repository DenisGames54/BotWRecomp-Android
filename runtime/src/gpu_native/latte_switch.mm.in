#include "@CMAKE_SOURCE_DIR@/runtime/src/gpu_native/gpu_native.h"

namespace latte {
namespace nb = gpu_native::backend;
static bool native() {
    static const bool n = gpu_native::native_selected();
    return n;
}

void create_renderer(void* nsview, int w, int h) {
    if (native()) nb::create_renderer(nsview, w, h);
    else latte_cemu_create_renderer(nsview, w, h);
}
void resize_window(int w, int h) { native() ? nb::resize_window(w, h) : latte_cemu_resize_window(w, h); }
void set_scanout_srgb(bool tv, bool srgb) { native() ? nb::set_scanout_srgb(tv, srgb) : latte_cemu_set_scanout_srgb(tv, srgb); }
void set_display_mode(int mode) { native() ? nb::set_display_mode(mode) : latte_cemu_set_display_mode(mode); }
void init() { native() ? nb::init() : latte_cemu_init(); }
void set_capture(int every, const char* dir) { native() ? nb::set_capture(every, dir) : latte_cemu_set_capture(every, dir); }
uint64_t submit(uint32_t addr, uint32_t ndw) {
    if (gpu_native::stats_interval()) gpu_native::stats_observe(addr, ndw);
    return native() ? nb::submit(addr, ndw) : latte_cemu_submit(addr, ndw);
}
uint64_t last_submitted() { return native() ? nb::last_submitted() : latte_cemu_last_submitted(); }
uint64_t retired() { return native() ? nb::retired() : latte_cemu_retired(); }
void wait_retired(uint64_t ts) { native() ? nb::wait_retired(ts) : latte_cemu_wait_retired(ts); }
uint32_t flip_requests() { return native() ? nb::flip_requests() : latte_cemu_flip_requests(); }
uint32_t flips_executed() { return native() ? nb::flips_executed() : latte_cemu_flips_executed(); }
void add_flip_request() { native() ? nb::add_flip_request() : latte_cemu_add_flip_request(); }
void wait_for_flip() { native() ? nb::wait_for_flip() : latte_cemu_wait_for_flip(); }
void wait_for_vsync() { native() ? nb::wait_for_vsync() : latte_cemu_wait_for_vsync(); }
uint64_t last_flip_time() { return native() ? nb::last_flip_time() : latte_cemu_last_flip_time(); }
uint64_t last_vsync_time() { return native() ? nb::last_vsync_time() : latte_cemu_last_vsync_time(); }
uint32_t swap_interval() { return native() ? nb::swap_interval() : latte_cemu_swap_interval(); }
void set_swap_interval(uint32_t v) { native() ? nb::set_swap_interval(v) : latte_cemu_set_swap_interval(v); }
void set_event_sink(std::function<void(Event)> sink) {
    if (native()) nb::set_event_sink([sink](uint32_t e) { sink((Event)e); });
    else latte_cemu_set_event_sink(std::move(sink));
}
}  // namespace latte
